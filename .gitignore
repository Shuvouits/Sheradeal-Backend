# ==========================================
# SheraDeal - Laravel 12 Backend
# ==========================================

# Dependencies
/vendor/
/node_modules/

# Environment files and secrets
.env
.env.*
!.env.example

# Composer authentication
/auth.json

# Laravel application key and generated secrets
/storage/*.key

# Laravel logs
/storage/logs/*
!/storage/logs/.gitignore

# Framework-generated files
/storage/framework/cache/*
!/storage/framework/cache/.gitignore

/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore

/storage/framework/testing/*
!/storage/framework/testing/.gitignore

/storage/framework/views/*
!/storage/framework/views/.gitignore

# Legacy uploaded files
/storage/app/public/
/storage/app/private/

# Public storage symbolic link
/public/storage

# ==========================================
# Public Image Uploads
# ==========================================

# Images are uploaded directly to public/uploads
# Never commit user-uploaded images
/public/uploads/

# ==========================================
# Apache / Laravel Rewrite Configuration
# ==========================================

# Keep Laravel rewrite files in Git
!/.htaccess
!/public/.htaccess

# Laravel bootstrap cache
/bootstrap/cache/*.php

# Application caches
.phpunit.result.cache
.phpunit-watcher.yml
.phpunit.cache/

# Frontend build output
/public/build/
/public/hot
/public/mix-manifest.json

# Vite
/dist/

# Testing
/coverage/

# IDE files
/.idea/
/.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Temporary files
*.tmp
*.temp
*.bak
*.old
*.orig

# Local databases
*.sqlite
*.sqlite3
/database/database.sqlite

# Archives and backups
*.zip
*.rar
*.7z
*.tar
*.gz
*.sql
*.sql.gz

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# Hosting-specific files
/.htpasswd

# Local tooling
/.phpactor.yml
/.phpunit-watcher.yml

# Docker overrides
/docker-compose.override.yml

# Deployment artifacts
/.vercel/
